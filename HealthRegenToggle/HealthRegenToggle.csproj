<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyTitle>HealthRegenToggle</AssemblyTitle>
    <Product>HealthRegenToggle</Product>
  </PropertyGroup>
	<ItemGroup>
		<Reference Include="BoneLib">
		  <HintPath>$(HOME)/repos/BL-Libs/Mods/BoneLib.dll</HintPath>
		</Reference>
		<Reference Include="MelonLoader">
		  <HintPath>$(HOME)/repos/BL-Libs/PC/MelonLoader/net6/MelonLoader.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine">
		  <HintPath>$(HOME)/repos/BL-Libs/PC/MelonLoader/Il2CppAssemblies/UnityEngine.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
		  <HintPath>$(HOME)/repos/BL-Libs/PC/MelonLoader/Il2CppAssemblies/UnityEngine.CoreModule.dll</HintPath>
		</Reference>
		<Reference Include="Il2CppSLZ.Marrow">
		  <HintPath>$(HOME)/repos/BL-Libs/PC/MelonLoader/Il2CppAssemblies/Il2CppSLZ.Marrow.dll</HintPath>
		</Reference>
		<Reference Include="Il2Cppmscorlib">
		  <HintPath>$(HOME)/repos/BL-Libs/PC/MelonLoader/Il2CppAssemblies/Il2Cppmscorlib.dll</HintPath>
		</Reference>
		<Reference Include="Il2CppInterop.Runtime">
		  <HintPath>$(HOME)/repos/BL-Libs/PC/MelonLoader/net6/Il2CppInterop.Runtime.dll</HintPath>
		</Reference>
	</ItemGroup>
	<Target Name="CopyOutput" AfterTargets="Build" Condition="'$(HOME)/repos/HealthRegenToggle/Staging/Thunderstore/Mods' != ''">
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(HOME)/repos/HealthRegenToggle/Staging/Thunderstore/Mods"/>
	</Target>	
</Project>
